<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title data-i18n="dashboard.pageTitle"><%= title || "Dashboard" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

  <!-- Handsontable CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/handsontable@14.3.0/dist/handsontable.full.min.css" />

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/styles.css" />

</head>

<body
  class="bg-light"
  data-company-id="<%= user?.company_id ?? '' %>"
  data-is-admin="<%= isAdmin ? '1' : '0' %>"
  data-can-see-rates="<%= canSeeRates ? '1' : '0' %>"
  data-can-batch="<%= canUseBatch ? '1' : '0' %>"
  >
  
  <!-- Navbar -->
  <%- include("partials/navbar", { active: "dashboard" }); %>

  <div class="container py-4">
    <!-- Title -->
    <header class="mb-4">
      <div class="text-center">
      <h1 class="fw-bold text-primary display-5 mb-1" id="companyTitle">
        
      </h1>
      <p class="text-muted small" data-i18n="dashboard.subtitle">
        Daily records of jobs done
      </p>
      </div>
    </header>

    <!-- Record New Work Entry card -->
    <section class="card shadow-lg border-0 rounded-4 mb-4">
      <div class="card-body p-4">

        <!-- Header with mode switch -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4 fw-bold mb-0" data-i18n="dashboard.recordTitle">Record New Work Entry</h2>

          <div class="form-check form-switch" id="batchModeSwitchRow">
            <input class="form-check-input" type="checkbox" id="batchModeSwitch" />
            <label class="form-check-label small fw-medium" for="batchModeSwitch" data-i18n="dashboard.excelBatchEntry">
              Excel-style Batch Entry
            </label>
          </div>
        </div>

        <!-- ========== MODE 1: Single-entry form ========== -->
        <div id="singleEntryMode">
          <form>
            <div class="row g-3 mb-3">
              <!-- Job No -->
               <!-- Date -->
              <div class="col-6">
                <label for="workDate" class="form-label fw-medium" data-i18n="dashboard.date">Date</label>
                <input type="date" id="workDate" class="form-control" />
              </div>
              <div class="col-6"></div>
              
              <div class="col-6">
                <label class="form-label fw-medium" data-i18n="dashboard.jobNo1">Job No1</label>
                <input type="text" id="jobNo1" class="form-control" placeholder="Enter Job No1"
                  data-i18n-placeholder="dashboard.enterJobNo1" />
              </div>

              <div class="col-6">
                <label class="form-label fw-medium" data-i18n="dashboard.jobNo2">Job No2</label>
                <input type="text" id="jobNo2" class="form-control" placeholder="Enter Job No2"
                  data-i18n-placeholder="dashboard.enterJobNo2" />
              </div>

              

              <!-- Job Code & Type (multi-select) -->
              <div class="col-6">
                <label for="jobCodeMulti" class="form-label fw-medium" data-i18n="dashboard.jobCodeType">Job Code &amp; Type</label>
                <div class="d-flex gap-2 mb-2">
                  <input id="jobSearch" class="form-control form-control-sm" placeholder="Search jobs..."
                    data-i18n-placeholder="dashboard.searchJobsPlaceholder" />
                  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="selectAllJobs(true)" data-i18n="dashboard.selectAll">All</button>
                  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="selectAllJobs(false)" data-i18n="dashboard.selectNone">None</button>
                </div>

                <div id="jobCheckboxList"
                    class="border rounded-3 p-2"
                    style="max-height: 220px; overflow:auto; background:#fff;">
                  <div class="text-muted small fst-italic" data-i18n="dashboard.loadingJobs">Loading jobs...</div>
                </div>

                <div class="form-text" data-i18n="dashboard.clickToAddJobs">
                  Click to add job(s).
                </div>

              </div>

              <!-- Hours per selected job -->
              <div class="col-6">
                <label class="form-label fw-medium" data-i18n="dashboard.jobHoursPerSelected">Job Hours (per selected job)</label>

                <div id="jobHoursContainer" class="d-flex flex-column gap-2">
                  <!-- JS will render rows here -->
                  <div class="text-muted small fst-italic" data-i18n="dashboard.selectJobsToEnterHours">Select job(s) to enter hours.</div>
                </div>
              </div>

              <!-- Worker Name -->
              <div class="col-6">
                <label for="workerSelect" class="form-label fw-medium" data-i18n="dashboard.workerId">Worker ID</label>
                <select id="workerSelect" class="form-select">
                  <option value="" disabled selected data-i18n="dashboard.selectWorker">Select worker</option>
                </select>
              </div>

                <!-- Fees Collected (optional) -->
                <div class="col-6">
                  <label for="feesCollected" class="form-label fw-medium" data-i18n="dashboard.feesCollectedActual">Fees Collected (actual)</label>
                  <input
                    type="number"
                    id="feesCollected"
                    class="form-control"
                    placeholder="0"
                    min="0"
                    step="0.5"
                  />
                  <div class="form-text" data-i18n="dashboard.feesCollectedHelp">
                    If customer paid more than fee (tips), record the actual amount here.
                  </div>
                </div>
                
                <!-- Note -->
                <div class="col-12">
                <label for="note" class="form-label fw-medium" data-i18n="dashboard.noteOptional">Note (optional)</label>
                <input
                    type="text"
                    id="note"
                    class="form-control"
                    placeholder="e.g. extra request / remark"
                    data-i18n-placeholder="dashboard.notePlaceholder"
                />
                </div>

                <!-- ✅ Payment method: Bank transfer toggle (clickable card) -->
                <div class="col-12 mt-2">
                <label
                    for="isBank"
                    id="isBankCard"
                    class="d-flex align-items-center gap-3 p-3 rounded-3 border bank-card"
                    style="cursor:pointer; user-select:none;"
                >
                    <input
                    class="form-check-input m-0"
                    type="checkbox"
                    id="isBank"
                    style="transform: scale(1.2);"
                    />

                    <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-wallet2 fs-5 text-primary"></i>
                    <span class="fw-bold" data-i18n="dashboard.bankTransferPaymentMethod">Bank Transfer Payment Method</span>
                    </div>

                    <span class="text-muted small ms-2" data-i18n="dashboard.bankTransferHelp">
                    (Unticked = Cash Payout)
                    </span>
                </label>
                </div>


              <!-- 🔀 Switch: show custom overrides -->
              <div class="col-12 mt-2" id="customOverrideSwitchRow">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" id="useCustomOverride" />
                  <label class="form-check-label fw-medium" for="useCustomOverride" data-i18n="dashboard.useCustomOverrides">
                    Use Custom Overrides
                  </label>
                </div>
              </div>

              <!-- Custom overrides (hidden unless switch ON) -->
              <div class="col-12" id="customOverrideOptions" style="display: none;">
                <div class="row g-2 align-items-end mt-1">
                  <div class="col-md-6">
                    <label class="form-label small" data-i18n="dashboard.customerCustomPrice">Customer Custom Price (per hour)</label>
                    <input type="number" step="0.01" id="customCustomerRate" class="form-control"
                      placeholder="Leave blank = normal price" />
                  </div>

                  <div class="col-md-6">
                    <label class="form-label small" data-i18n="dashboard.workerCustomWage">Worker Custom Wage (per hour)</label>
                    <input type="number" step="0.01" id="customWageRate" class="form-control"
                      placeholder="Leave blank = base wage" />
                  </div>
                </div>
              </div>

            </div>

            <button type="button" class="btn btn-primary btn-lg w-100" onclick="addEntryToTable()" data-i18n="dashboard.recordNewEntryBtn">
              Record New Entry
            </button>
          </form>
        </div>

        <!-- ========== MODE 2: Handsontable Excel-style batch ========== -->
        <div id="batchEntryMode" style="display: none;">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted small mb-0" data-i18n-html="dashboard.batchInstructions">
              Enter multiple rows in the grid below, then click
              <strong>"Add Rows to Pending Table"</strong>.
            </p>

            <div class="d-flex align-items-center gap-2">
              <div class="input-group input-group-sm" style="width: 180px;">
                <span class="input-group-text" data-i18n="dashboard.rows">Rows</span>
                <input type="number" class="form-control" id="batchRowCount" min="1" max="500" value="10" />
                <button class="btn btn-outline-secondary" type="button" onclick="applyBatchRowCount()" data-i18n="dashboard.set">
                  Set
                </button>
              </div>
            </div>
          </div>

          <div class="alert alert-light border rounded-3 py-2 small mb-2">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-info-circle text-primary"></i>
              <div>
                <span data-i18n-html="dashboard.batchInfo">Batch mode defaults to <b>Cash</b>. If it is a bank transfer, fill the “Is Bank” column with <code>y</code>.</span>
              </div>
            </div>
          </div>

          <div id="hotBatch" style="width: 100%; min-height: 300px;"></div>

          <div class="d-flex justify-content-end mt-3">
            <button type="button" class="btn btn-primary" onclick="addBatchRowsToPending()" data-i18n="dashboard.addRowsToPending">
              Add Rows to Pending Table
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- Work Entries table card -->
    <section class="card shadow-lg border-0 rounded-4">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h2 class="h4 fw-bold mb-1" data-i18n="dashboard.workEntries">Work Entries</h2>
          </div>
          <button type="button" class="btn btn-success" id="importExcelBtn" onclick="openImportModal('work_entries')">
            <i class="bi bi-file-earmark-spreadsheet"></i>
            <span data-i18n="dashboard.importWorkEntriesCsv">Import Work Entries (CSV)</span>
          </button>
        </div>

        <div class="table-responsive rounded-3 border">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-primary small text-uppercase">
              <tr>
                <th scope="col" data-i18n="dashboard.tableNumber">#</th>
                <th scope="col" data-i18n="dashboard.tableDate">Date</th>
                <th scope="col" data-i18n="dashboard.tableJobNo1">Job No1</th>
                <th scope="col" data-i18n="dashboard.tableJobNo2">Job No2</th>
                <th scope="col" data-i18n="dashboard.tableWorker">Worker</th>
                <th scope="col" data-i18n="dashboard.tableJobCodeType">Job Code &amp; Type</th>
                <th scope="col" data-i18n="dashboard.tableHours">Hours</th>
                <th scope="col" data-i18n="dashboard.tablePayType">Pay Type</th>
                <th scope="col" data-i18n="dashboard.tableFeesCollected">Fees Collected</th>

                <th scope="col" data-col="cust_rate" data-i18n="dashboard.tableCustRate">Cust_Rate</th>
                <th scope="col" data-col="cust_total" data-i18n="dashboard.tableCustTotal">Cust_Total</th>
                <th scope="col" data-col="wage_rate" data-i18n="dashboard.tableWageRate">Wage Rate</th>
                <th scope="col" data-col="wage_total" data-i18n="dashboard.tableWageTotal">Wage Total</th>


                <th scope="col" data-i18n="dashboard.tableNote">Note</th>
                <th scope="col" data-i18n="dashboard.tableActions">Actions</th>
              </tr>
            </thead>
            
            <div id="saveStatus" class="small text-muted mb-2" style="display:none;" data-i18n="dashboard.savingToDatabase">
                Saving to database...
            </div>


            <tbody id="workEntriesBody">
              <tr class="text-muted">
                <td colspan="15" class="text-center fst-italic py-3" data-i18n="dashboard.noWorkEntries">
                  No work entries recorded yet.
                </td>
              </tr>
            </tbody>

            <tfoot>
              <tr class="fw-bold">
                <td id="grandTotalLabelCell" colspan="13" class="text-end text-primary" data-i18n="dashboard.grandTotal">
                  GRAND TOTAL:
                </td>
                <td class="text-primary" id="grandCustomerTotalCell">0.00</td>
                <td class="text-end text-primary" hidden>Wages Total:</td>
                <td class="text-primary" id="grandTotalCell" hidden>0.00</td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- Confirm button below table -->
        <div class="mt-3 text-end">
            <button
            type="button"
            id="confirmSaveBtn"
            class="btn btn-success"
            onclick="confirmEntries()"
            data-i18n="dashboard.confirmSave"
            >
            Confirm &amp; Save
            </button>

        </div>
      </div>
    </section>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Handsontable JS -->
  <script src="https://cdn.jsdelivr.net/npm/handsontable@14.3.0/dist/handsontable.full.min.js"></script>

  <!-- Global company switcher -->
  <script src="/js/company-switcher.js"></script>

  <%- include("partials/importModal") %>

  <!-- Dashboard logic -->
  <script src="/js/i18n.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/importExport.js"></script>
</body>

</html>
