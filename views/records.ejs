<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title data-i18n="records.pageTitle"><%= title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body 
  class="bg-light"
  data-company-id="<%= user?.company_id ?? '' %>"
  data-can-see-rates="<%= (can('WORK_ENTRY_EDIT_RATES')) ? '1' : '0' %>">
  <%- include("partials/navbar", { active: "records" }); %>

  <div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h1 class="fw-bold text-primary display-6">
          <i class="bi bi-list-ul me-2"></i> <span data-i18n="records.title">Work Entries Records</span>
        </h1>
        <p class="text-muted small mb-0" data-i18n="records.subtitle">
          View all saved work entries from the database.
        </p>
      </div>

      <div class="d-flex gap-2">
        <button class="btn btn-outline-danger rounded-pill" id="deleteSelectedBtn" disabled>
          <i class="bi bi-trash"></i> <span data-i18n="records.deleteSelected">Delete Selected</span>
        </button>
      </div>
    </div>

    <!-- Filters row -->
    <div class="row g-3 mb-3">
      <div class="d-flex gap-4 col-md-12">
        <div class="col-md-3">
          <label class="form-label" data-i18n="records.filters.fromDate">From Date</label>
          <input type="date" id="filterDateFrom" class="form-control" />
        </div>

        <div class="col-md-3">
          <label class="form-label" data-i18n="records.filters.toDate">To Date</label>
          <input type="date" id="filterDateTo" class="form-control" />
        </div>
      </div>

      <div class="col-md-3">
        <label class="form-label small mb-1" data-i18n="records.filters.jobNo">Filter by Job No (1 / 2)</label>
        <input type="text" id="filterJobNo" class="form-control form-control-sm" placeholder="Job No1 or Job No2" data-i18n-placeholder="records.filters.jobNoPlaceholder" />
      </div>

      <div class="col-md-3">
        <label class="form-label small mb-1" data-i18n="records.filters.worker">Filter by Worker</label>
        <input type="text" id="filterWorker" class="form-control form-control-sm" placeholder="Worker code / name" data-i18n-placeholder="records.filters.workerPlaceholder" />
      </div>

      <div class="col-md-3">
        <label class="form-label small mb-1" data-i18n="records.filters.job">Filter by Job (Code / Type)</label>
        <input type="text" id="filterJob" class="form-control form-control-sm" placeholder="Job code or type" data-i18n-placeholder="records.filters.jobPlaceholder" />
      </div>

      <div class="col-md-3">
        <label class="form-label small mb-1" data-i18n="records.filters.note">Filter by Note</label>
        <input type="text" id="filterNote" class="form-control form-control-sm" placeholder="Discount / remark..." data-i18n-placeholder="records.filters.notePlaceholder" />
      </div>

      <div class="col-md-3">
        <label class="form-label small mb-1" data-i18n="records.filters.payType">Payment Type</label>
        <select id="filterPayType" class="form-select form-select-sm">
          <option value="" data-i18n="records.filters.payAll">All</option>
          <option value="cash" data-i18n="records.filters.payCash">Cash</option>
          <option value="bank" data-i18n="records.filters.payBank">Bank</option>
        </select>
      </div>

      <div class="col-md-3 d-flex align-items-end">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="filterMismatchTotals">
          <label class="form-check-label small" for="filterMismatchTotals" data-i18n="records.filters.mismatch">
            Only mismatched totals (Customer Total ≠ Fees Collected)
          </label>
        </div>
      </div>
    </div>

    <!-- Sort + export row -->
    <div class="row mb-4 align-items-center">
      <div class="col-lg-8 col-md-12"></div>

      <div class="col-lg-4 col-md-12 mt-3 mt-lg-0 text-md-start text-lg-end">
        <div class="d-inline-block me-2">
          <button class="btn btn-outline-secondary rounded-pill dropdown-toggle"
                  type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-sort-alpha-down"></i> <span data-i18n="records.sort">Sort</span>
          </button>

          <ul class="dropdown-menu">
            <li><a class="dropdown-item sort-option" data-sort="date_asc" href="#" data-i18n="records.sort.dateAsc">Date ↑ (Oldest)</a></li>
            <li><a class="dropdown-item sort-option" data-sort="date_desc" href="#" data-i18n="records.sort.dateDesc">Date ↓ (Newest)</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item sort-option" data-sort="jobno_asc" href="#" data-i18n="records.sort.jobAsc">Job No ↑</a></li>
            <li><a class="dropdown-item sort-option" data-sort="jobno_desc" href="#" data-i18n="records.sort.jobDesc">Job No ↓</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item sort-option" data-sort="worker_asc" href="#" data-i18n="records.sort.workerAsc">Worker ↑</a></li>
            <li><a class="dropdown-item sort-option" data-sort="worker_desc" href="#" data-i18n="records.sort.workerDesc">Worker ↓</a></li>
          </ul>
        </div>

        <button class="btn btn-outline-success rounded-pill" id="exportRecordsBtn">
          <i class="bi bi-download"></i> <span data-i18n="records.export">Export</span>
        </button>
      </div>
    </div>

    <!-- Records table -->
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-0">
        <div class="table-responsive">

          <!-- Top controls -->
          <div class="d-flex justify-content-between align-items-center mb-2 px-2 pt-2">
            <div class="d-flex align-items-center gap-2">
              <small class="text-muted" id="recordsCountTop"></small>

              <div class="d-flex align-items-center gap-2">
                <small class="text-muted" data-i18n="records.rows">Rows:</small>
                <select id="recordsPageSize" class="form-select form-select-sm" style="width: 90px;">
                  <option value="10" selected>10</option>
                  <option value="20">20</option>
                  <option value="50">50</option>
                  <option value="100">100</option>
                </select>
              </div>
            </div>

            <nav>
              <ul class="pagination pagination-sm mb-0" id="recordsPaginationTop"></ul>
            </nav>
          </div>

          <table class="table table-hover mb-0" id="recordsTable">
            <thead class="table-primary small text-uppercase">
              <tr>
                <th scope="col" class="text-center" style="width: 40px;">
                  <input type="checkbox" id="selectAllRecords" />
                </th>
                <th scope="col" data-i18n="records.table.number">#</th>
                <th scope="col" data-i18n="records.table.date">Date</th>
                <th scope="col" data-i18n="records.table.jobNo1">Job No1</th>
                <th scope="col" data-i18n="records.table.jobNo2">Job No2</th>
                <th scope="col" data-i18n="records.table.worker">Worker</th>
                <th scope="col" data-i18n="records.table.job">Job</th>
                <th scope="col" class="text-end" data-i18n="records.table.hours">Hours</th>
                <th scope="col" class="text-end" data-i18n="records.table.fees">Fees Collected</th>

                <th scope="col" class="text-end" data-col="cust_rate" data-i18n="records.table.custRate">Cust_Rate</th>
                <th scope="col" class="text-end" data-col="cust_total" data-i18n="records.table.custTotal">Cust_Total</th>

                <th scope="col" class="text-end" data-col="wage_rate" data-i18n="records.table.wageRate">Wage Rate</th>
                <th scope="col" class="text-end" data-col="wage_total" data-i18n="records.table.wageTotal">Wage Total</th>

                <th scope="col" data-i18n="records.table.note">Note</th>
                <th scope="col" class="text-end" data-i18n="records.table.actions">Actions</th>
              </tr>
            </thead>

            <tbody id="recordsBody">
              <tr>
                <td id="recordsLoadingCell" colspan="15" class="text-center text-muted py-4">
                  <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                  <span data-i18n="records.loading">Loading records...</span>
                </td>
              </tr>
            </tbody>

            <tfoot>
              <tr class="fw-bold" id="recordsFeesTotalRow">
                <td id="recordsFeesLabelCell" colspan="15" class="text-end text-dark" data-i18n="records.totalFees">
                  GRAND TOTAL (ACTUAL COLLECTED):
                </td>
                <td class="text-dark" id="recordsGrandTotalFees">0.00</td>
              </tr>

              <tr class="fw-bold" id="recordsCustomerTotalRow">
                <td id="recordsCustomerLabelCell" colspan="15" class="text-end text-success" data-i18n="records.totalCustomer">
                  GRAND TOTAL (CUSTOMER):
                </td>
                <td class="text-success" id="recordsGrandTotalCustomer">0.00</td>
              </tr>

              <tr class="fw-bold" id="recordsWageTotalRow">
                <td id="recordsWageLabelCell" colspan="15" class="text-end text-primary" data-i18n="records.totalWages">
                  TOTAL WAGES:
                </td>
                <td class="text-primary" id="recordsGrandTotalWage">0.00</td>
              </tr>
            </tfoot>


          </table>

          <!-- Bottom controls -->
          <div class="d-flex justify-content-between align-items-center mt-2 px-2 pb-2">
            <small class="text-muted" id="recordsCountBottom"></small>
            <nav>
              <ul class="pagination pagination-sm mb-0" id="recordsPaginationBottom"></ul>
            </nav>
          </div>

        </div>
      </div>
    </div>

  </div>

  <div class="modal fade" id="editEntryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content rounded-4">
        <div class="modal-header">
          <h5 class="modal-title" data-i18n="records.modal.title">Edit Work Entry</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="editEntryId" />

          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label" data-i18n="records.modal.date">Date</label>
              <input type="date" id="editWorkDate" class="form-control" />
            </div>

            <div class="col-md-4">
              <label class="form-label" data-i18n="records.modal.jobNo1">Job No1</label>
              <input type="text" id="editJobNo1" class="form-control" />
            </div>

            <div class="col-md-4">
              <label class="form-label" data-i18n="records.modal.jobNo2">Job No2</label>
              <input type="text" id="editJobNo2" class="form-control" />
            </div>

            <div class="col-md-4">
              <label class="form-label" data-i18n="records.modal.worker">Worker</label>
              <select id="editWorkerId" class="form-select"></select>
            </div>


            <div class="col-md-4">
              <label class="form-label" data-i18n="records.modal.hours">Hours</label>
              <input type="number" id="editAmount" class="form-control" min="0" step="0.5" />
            </div>

            <div class="col-md-4">
              <label class="form-label" data-i18n="records.modal.payType">Pay Type</label>
              <select id="editIsBank" class="form-select">
                <option value="0" data-i18n="records.modal.payCash">Cash</option>
                <option value="1" data-i18n="records.modal.payBank">Bank</option>
              </select>
            </div>

            <div class="col-md-4">
              <label class="form-label" data-i18n="records.modal.job">Job</label>
              <select id="editJobCode" class="form-select"></select>
            </div>

            

            <div class="col-12">
              <label class="form-label" data-i18n="records.modal.note">Note</label>
              <input type="text" id="editNote" class="form-control" />
            </div>

          </div>


          <div class="row g-3 mt-1" id="ratesFields">
            <div class="my-2 border-top"></div>

            <div class="col-md-12">
              <label class="form-label" data-i18n="records.modal.wageTier">Wage Tier</label>
              <select id="editWageTierId" class="form-select"></select>
            </div>

              <div class="col-md-6">
                <label class="form-label" data-i18n="records.modal.customerRate">Customer Rate</label>
                <input type="number" step="0.01" class="form-control" id="editCustomerRate">
              </div>

              <div class="col-md-6">
                <label class="form-label" data-i18n="records.modal.wageRate">Wage Rate</label>
                <input type="number" step="0.01" class="form-control" id="editWageRate">
              </div>

              <div class="col-md-6">
                <label class="form-label" data-i18n="records.modal.customerTotal">Customer Total</label>
                <input type="text" class="form-control" id="editCustomerTotal" disabled>
              </div>

              <div class="col-md-6">
                <label class="form-label" data-i18n="records.modal.wageTotal">Wage Total</label>
                <input type="text" class="form-control" id="editWageTotal" disabled>
              </div>
            </div>
        </div>

        <div class="modal-footer">
          <div class="me-auto small text-muted" id="editEntryHint"></div>
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-i18n="records.modal.cancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="saveEditEntryBtn">
            <span data-i18n="records.modal.save">Save Changes</span>
          </button>
        </div>
      </div>
    </div>
  </div>


  <script type="application/json" id="pagePerms">
    <%- JSON.stringify({
      canEditRates: (can("WORK_ENTRY_EDIT_RATES")),
      canEditEntry: (can("WORK_ENTRY_EDIT")),
      canDeleteEntry: (can("WORK_ENTRY_DELETE")),
    }) %>
  </script>

  <script>
    const perms = JSON.parse(document.getElementById("pagePerms").textContent);
    window.CAN_EDIT_RATES = perms.canEditRates;
    window.CAN_EDIT_ENTRY = perms.canEditEntry;
    window.CAN_DELETE_ENTRY = perms.canDeleteEntry;
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/company-switcher.js"></script>
  <script src="/js/i18n.js"></script>
  <script src="/js/records.js"></script>
</body>
</html>
